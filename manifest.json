{
    "manifest_version":  3,
    "name":  "Keimenon Lite",
    "version":  "1.1.12",
    "description":  "Extract user-authored messages from AI chat pages locally.",
    "permissions":  [
                        "activeTab",
                        "scripting",
                        "sidePanel",
                        "storage"
                    ],
    "host_permissions":  [
                             "https://chatgpt.com/*",
                             "https://claude.ai/*",
                             "https://chat.openai.com/*"
                         ],
    "background":  {
                       "service_worker":  "src/background.js"
                   },
    "side_panel":  {
                       "default_path":  "src/ui/sidepanel.html"
                   },
    "action":  {
                   "default_title":  "Open Keimenon Lite"
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://chatgpt.com/*",
                                                "https://claude.ai/*",
                                                "https://chat.openai.com/*"
                                            ],
                                "js":  [
                                           "src/content.bundle.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "src/**/*.js"
                                                       ],
                                         "matches":  [
                                                         "*://chatgpt.com/*",
                                                         "*://claude.ai/*",
                                                         "*://chat.openai.com/*"
                                                     ]
                                     }
                                 ],
    "oauth2":  {
                   "client_id":  "\u003cYOUR_CLIENT_ID\u003e",
                   "scopes":  [
                                  "https://www.googleapis.com/auth/userinfo.email",
                                  "https://www.googleapis.com/auth/userinfo.profile",
                                  "openid"
                              ]
               },
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              }
}
