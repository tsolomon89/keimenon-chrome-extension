{
    "manifest_version":  3,
    "name":  "Keimenon Lite",
    "version":  "1.4.24",
    "description":  "Extract and export specific messages or full conversations from AI chat pages locally. Privacy-first.",
    "permissions":  [
                        "sidePanel",
                        "activeTab"
                    ],
    "background":  {
                       "service_worker":  "src/background.js"
                   },
    "side_panel":  {
                       "default_path":  "src/ui/sidepanel.html"
                   },
    "action":  {
                   "default_title":  "Open Keimenon Lite"
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://chatgpt.com/*",
                                                "https://claude.ai/*",
                                                "https://chat.openai.com/*",
                                                "https://gemini.google.com/*",
                                                "https://x.com/*",
                                                "https://grok.com/*"
                                            ],
                                "js":  [
                                           "src/content.bundle.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "icons":  {
                  "16":  "assets/favicon/keimenon-favicon-16.png",
                  "48":  "assets/favicon/keimenon-favicon-48.png",
                  "128":  "assets/favicon/keimenon-favicon-128.png"
              }
}
