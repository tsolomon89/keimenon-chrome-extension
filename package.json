{
    "name":  "keimenon-lite",
    "version":  "1.3.6",
    "description":  "Keimenon Lite is a Chrome extension that extracts **user-authored messages only** from supported AI chat pages (ChatGPT + Claude) by reading the current page DOM. It renders these messages in a Material Design 3 (M3) side panel.",
    "main":  "index.js",
    "directories":  {
                        "test":  "test"
                    },
    "scripts":  {
                    "test":  "vitest run",
                    "build":  "npx esbuild src/content.js --bundle --outfile=src/content.bundle.js --format=iife"
                },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "type":  "commonjs",
    "devDependencies":  {
                            "@types/node":  "^25.0.10",
                            "jsdom":  "^27.4.0",
                            "typescript":  "^5.9.3",
                            "vitest":  "^4.0.17"
                        }
}
